Options -Indexes -MultiViews
DirectoryIndex index.html

RewriteEngine On
# Preserve Bearer headers on CGI/FastCGI hosts.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
# Private files must never fall through to the SPA (including absent files).
RewriteRule ^(?:server|\.git|\.aws|\.codex|\.agents)(?:/|$) - [F,END,NC]
RewriteRule (?:^|/)(?:\.[^/]+|config(?:\.example)?\.php|deploy(?:\.example)?\.json|.*\.sql)$ - [F,END,NC]
RewriteRule ^api(?:/.*)?$ api/index.php [END]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [END]

<IfModule mod_headers.c>
    # PHP and FastCGI can populate different header tables. Remove the normal
    # copies before setting the always table, including on error responses.
    Header onsuccess unset X-Powered-By
    Header always unset X-Powered-By
    Header onsuccess unset X-Content-Type-Options
    Header always set X-Content-Type-Options "nosniff"
    Header onsuccess unset Referrer-Policy
    Header always set Referrer-Policy "no-referrer"
    Header onsuccess unset X-Frame-Options
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
    # scripts/headers.js inserts the exact built inline-theme hash.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' __THEME_HASH__; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" "expr=%{REQUEST_URI} !~ m#^/api(?:/|$)#"
    Header always set Cache-Control "no-cache" "expr=%{REQUEST_URI} !~ m#^/(?:assets/|api(?:/|$))#"
</IfModule>
